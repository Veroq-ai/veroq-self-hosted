# ============================================================
# VeroQ Shield (Self-Hosted) — Configuration
# ============================================================

# LLM Provider (required)
# Works with any OpenAI-compatible API: OpenAI, Azure, Ollama, vLLM, NVIDIA NIM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# LLM Tuning (optional)
# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0

# VeroQ API (optional — enables external factual verification)
# Without this, only groundedness mode is available (verify against your documents)
# Get a free key at https://veroq.ai
# VEROQ_API_KEY=your_key_here

# Server
PORT=3000
